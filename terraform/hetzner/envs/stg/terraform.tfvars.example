# stg env — Terraform variables
# Copy to terraform.tfvars (git-ignored) and fill in real values.

hcloud_token = "your-hetzner-api-token"

# Per-env per-role SSH pubkeys (ADR 0006). The DEPLOY key's private half is the
# stg-scoped CI DEPLOY_SSH_PRIVATE_KEY secret; the ROOT key is owner-workstation-only
# and its private half is NEVER put in a GH secret. Point these at your minted stg
# pubkeys; the checked-in defaults are only for CI/cold-rebuild provisioning.
deploy_ssh_public_key_path = "~/.ssh/noorinalabs_stg_deploy.pub"
root_ssh_public_key_path   = "~/.ssh/noorinalabs_stg_root.pub"

# Restrict SSH in stg if you have an operator CIDR / VPN. Default ["0.0.0.0/0"] is open.
# ssh_source_ips = ["203.0.113.0/24"]

ghcr_auth_b64 = "base64('username:ghcr-token')"

# user-service secrets (stg)
user_postgres_password  = "a-strong-stg-password-at-least-16-chars"
user_redis_password     = "a-strong-stg-password-at-least-16-chars"
user_service_jwt_secret = "a-strong-stg-secret-at-least-32-chars"

# Non-admin QA test-user seed (stg, deploy#508). Leave both empty to disable
# the seed. test_user_email is an identifier (non-secret); test_user_password
# must be at least 16 chars when set.
test_user_email    = "qa+test@stg.noorinalabs.com"
test_user_password = "a-strong-qa-password-at-least-16-chars"
